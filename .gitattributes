# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.ts    text eol=lf

# PowerShell scripts: CRLF (Windows-only)
*.ps1   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.svg   text eol=lf