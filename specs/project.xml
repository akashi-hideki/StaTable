<?xml version='1.0' encoding='utf-8'?>
<Project>
    <GlobalDefinitions>
        <SystemVariables>
            <Variable name="battery_voltage" type="uint16_t" unit="mV" default_value="0" group="Power" description="バッテリ電圧" />
            <Variable name="motor_current" type="int16_t" unit="mA" default_value="0" group="Motor" description="モータ電流" />
        </SystemVariables>
        <EventFlags>
            <Flag name="EVT_START_REQ" min_value="0" max_value="1" group="SystemEvents" description="起動要求" />
            <Flag name="EVT_MODE" min_value="0" max_value="3" group="SystemEvents" description="モード指示" />
        </EventFlags>
        <Interrupts>
            <Interrupt name="TIMER0" description="1ms周期タイマ" event_name="tick" is_timer="true">
                <Action guard="g_tick_100ms &gt;= 5" action="StateMachine_EnqueueEvent(EVENT_TICK);" />
                <Action guard="" action="g_system_tick++;&#10;UpdateDerivedTimers();" />
            </Interrupt>
        </Interrupts>
        <DevicePlaceholders>
            <Placeholder name="TIMER0_IRQ_FLAG" description="タイマ0割り込みフラグクリア用レジスタ" />
        </DevicePlaceholders>
        <TimerBase variable_name="g_system_tick" unit="1ms" data_type="volatile uint32_t">
            <Derived period_name="10ms" multiplier="10" variable_name="g_tick_10ms" data_type="uint8_t" />
            <Derived period_name="100ms" multiplier="100" variable_name="g_tick_100ms" data_type="uint8_t" />
            <Derived period_name="1s" multiplier="1000" variable_name="g_tick_1s" data_type="uint16_t" />
        </TimerBase>
    </GlobalDefinitions>
    <Tab name="Application">
        <StateMachine initial="Idle">
            <States>
                <State name="Idle" type="normal" parent="" entry="Idle_entry" exit="" do="" description="初期状態" />
                <State name="Active" type="normal" parent="" entry="" exit="" do="Active_do" description="動作中" />
                <State name="Error" type="normal" parent="" entry="Error_entry" exit="Error_exit" do="" description="エラー状態" />
                <State name="Halt" type="final" parent="" entry="" exit="" do="" description="停止状態" />
            </States>
            <Events>
                <Event name="start" id="1" kind="signal" params="" priority="0" description="起動要求" />
                <Event name="stop" id="2" kind="signal" params="" priority="0" description="停止要求" />
                <Event name="error" id="3" kind="signal" params="uint8_t err_code" priority="0" description="エラー通知" />
                <Event name="" id="0" kind="signal" params="" priority="0" description="完了遷移" />
            </Events>
            <RoleFunctions>
                <RoleFunction name="Sensor_Init" description="センサ初期化" return_type="int" arg1_type="uint8_t" arg1_name="channel" arg2_type="uint32_t" arg2_name="timeout_ms" />
                <RoleFunction name="Error_Log" description="エラーログ出力" return_type="void" arg1_type="int" arg1_name="err_code" arg2_type="int" arg2_name="level" />
            </RoleFunctions>
            <Transitions>
                <Transition source="Idle" event="start" guard="" action="init()" target="Active" transition_type="external" title="" />
                <Transition source="Active" event="stop" guard="" action="stop()" target="Idle" transition_type="external" title="" />
                <Transition source="Active" event="error" guard="err_code != 0" action="log()" target="Error" transition_type="external" title="" />
                <Transition source="Error" event="" guard="retry_count &lt; 3" action="retry_count++" target="Active" transition_type="external" title="" />
                <Transition source="Error" event="" guard="retry_count &gt;= 3" action="" target="Halt" transition_type="external" title="" />
                <Transition source="Active" event="error" guard="err_code == 0" action="ignore()" target="Active" transition_type="external" title="" />
            </Transitions>
        </StateMachine>
    </Tab>
</Project>